# ==========================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ==========================================

# Database:
# For local SQLite: sqlite+aiosqlite:///./budget.db
# For Free Neon.tech or Supabase Cloud PostgreSQL (Recommended for 24/7 persistence):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./budget.db

# CORS Allowed Origins (Comma separated or * for all)
CORS_ORIGINS=*

# Telegram Notifications Integration (Optional, 100% Free)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_NOTIFICATIONS_ENABLED=true

# Timezone (Default: Asia/Kolkata)
TIMEZONE=Asia/Kolkata
